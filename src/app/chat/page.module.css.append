.listeningOverlay {
    position: fixed;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100%;
    max-width: 480px;
    height: 100%;
    background-color: rgba(39, 174, 96, 0.9);
    color: white;
    z-index: 4000;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 1.5rem;
    font-weight: 700;
    backdrop-filter: blur(5px);
}
